# AI provider: ollama (local PC) | local (keywords only) | openai (paid)
AI_PROVIDER=ollama
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3:8b

# API
API_PORT=4000
# Local Docker: mongodb://localhost:27017/jobfinder
MONGODB_URI=mongodb://localhost:27017/jobfinder
REDIS_URL=redis://localhost:6379

# Next.js
NEXT_PUBLIC_API_URL=http://localhost:4000
WEB_ORIGIN=http://localhost:3000

# Optional Indeed/Adzuna (https://developer.adzuna.com/)
ADZUNA_APP_ID=
ADZUNA_APP_KEY=

# LinkedIn + Indeed browser search: npm run playwright:install
COLLECT_CONCURRENCY=4
LINKEDIN_COLLECT_CONCURRENCY=3

# Optional: auto-solve Cloudflare Turnstile for Indeed
# https://www.capsolver.com/ or https://2captcha.com/
# CAPSOLVER_API_KEY=
# TWOCAPTCHA_API_KEY=
